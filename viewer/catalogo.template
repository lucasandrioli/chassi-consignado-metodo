<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cadastro de chaves · Chassi</title>
  <style>
    :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1d2941;background:#f4f6fa;font-size:14px}
    *{box-sizing:border-box}body{margin:0}button,input{font:inherit}button{cursor:pointer}a{color:#335bc9;text-decoration:none}a:hover{text-decoration:underline}
    .shell{display:grid;grid-template-columns:250px minmax(0,1fr);min-height:100vh}.rail{background:#142039;color:#dce6ff;padding:25px 15px;position:sticky;top:0;height:100vh;overflow:auto}
    .brand{padding:0 13px 26px;border-bottom:1px solid #33415e}.brand-mark{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#7665ed;color:white;font-weight:800;letter-spacing:-1px;margin-bottom:12px}.brand strong{display:block;color:#fff;font-size:18px;letter-spacing:-.5px}.brand span{font-size:12px;color:#aab8d3}
    .rail-label{margin:28px 13px 9px;text-transform:uppercase;letter-spacing:1.5px;color:#8da0c3;font-size:10px;font-weight:800}.stage-select,.product-select{display:flex;gap:6px;margin:0 6px 8px}.stage-select button,.product-select button{border:1px solid #405174;background:transparent;color:#dce6ff;border-radius:8px;padding:8px 10px;text-align:left}.stage-select button.active,.product-select button.active{border-color:#a7a0ff;background:#353e74;color:#fff}.stage-select button{width:100%}.product-select button{flex:1;text-align:center;font-weight:700}.screen-nav{display:grid;gap:4px}.screen-nav button{width:100%;padding:11px 12px;color:#c3d0e9;background:transparent;border:0;border-radius:8px;text-align:left;display:flex;gap:11px;align-items:center}.screen-nav button:hover,.screen-nav button.active{background:#253653;color:#fff}.screen-nav .number{font-size:11px;color:#8aa0ca;min-width:17px}.rail-foot{margin:30px 12px 0;padding-top:20px;border-top:1px solid #33415e;font-size:12px;line-height:1.5;color:#9eafcb}.rail-foot a{color:#b9b7ff}
    main{min-width:0;padding:34px clamp(24px,4vw,58px) 90px;max-width:1700px;width:100%;margin:auto}.eyebrow{color:#5c55bb;font-size:11px;letter-spacing:1.7px;text-transform:uppercase;font-weight:800}.top{display:flex;justify-content:space-between;gap:18px;align-items:start}.top h1{font-size:clamp(27px,3vw,38px);letter-spacing:-1.5px;margin:7px 0 7px;color:#1b2740}.intro{margin:0;color:#60708b;line-height:1.5;max-width:760px}.proof{background:#fdf3d9;border:1px solid #f2dfa4;color:#8a6419;padding:9px 12px;border-radius:30px;white-space:nowrap;font-size:11px;font-weight:800}
    .stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:29px 0}.stat{background:white;border:1px solid #e3e8f1;border-radius:14px;padding:16px 18px;box-shadow:0 2px 9px rgba(20,32,57,.025)}.stat strong{font-size:27px;letter-spacing:-1px;display:block;color:#263453}.stat span{font-size:11px;color:#718099;text-transform:uppercase;font-weight:800;letter-spacing:.8px}
    .section-head{display:flex;justify-content:space-between;gap:15px;align-items:end;margin:31px 0 12px}.section-head h2{font-size:19px;margin:0;letter-spacing:-.5px}.section-head p{margin:5px 0 0;color:#667590;font-size:12px;line-height:1.45}.section-head .minor{font-size:12px;color:#677897}.panel{background:white;border:1px solid #e3e8f1;border-radius:15px;box-shadow:0 2px 12px rgba(20,32,57,.025)}
    .map-wrap{overflow-x:auto}.map{width:100%;border-collapse:collapse;min-width:830px}.map th{text-align:left;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#73819a;background:#f9fafe;padding:15px 18px;border-bottom:1px solid #e8edf4}.map td{padding:15px 18px;border-bottom:1px solid #edf0f5;vertical-align:top}.map tr:last-child td{border-bottom:0}.map tbody tr{cursor:pointer}.map tbody tr:hover{background:#fafbff}.map tbody tr.selected{background:#f4f3ff}.map .screen-name{font-weight:800;white-space:nowrap}.map .small{font-size:11px;color:#78869d;margin-top:3px}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;word-break:break-all;color:#334765}.key-inline{display:block;max-width:240px}.key-actions{display:flex;align-items:start;gap:7px}.copy{border:1px solid #dfe5f0;background:#fff;color:#596e99;border-radius:6px;padding:3px 6px;font-size:10px;flex:none}.copy:hover{border-color:#8078e5;color:#554ac4}.missing{color:#ad6827;font-size:11px}
    .detail-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:14px}.card{padding:21px 23px}.card-kicker{font-size:10px;text-transform:uppercase;color:#7965c4;font-weight:800;letter-spacing:1px}.card h3{font-size:18px;margin:6px 0 16px;letter-spacing:-.3px}.pair{border-top:1px solid #edf0f5;padding:11px 0;display:grid;grid-template-columns:135px minmax(0,1fr);gap:12px}.pair:first-of-type{border-top:0}.pair label{color:#74819a;font-size:11px;font-weight:700}.pair .value{min-width:0;font-size:12px}.pair .key-actions .mono{font-size:11px}.chain{display:flex;align-items:center;gap:8px;font-size:11px;color:#6b7791;margin-top:15px;flex-wrap:wrap}.chain span{padding:6px 9px;background:#f0f2f9;border-radius:7px}.chain strong{font-size:14px;color:#9aa6be}.ok{color:#278057;font-weight:800}.warn{color:#a9681f;font-weight:800}
    .collections{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.collection{padding:17px 18px}.collection h3{margin:0 0 7px;font-size:14px}.collection .collection-key{min-height:38px}.modes{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.mode{background:#f0f3f8;border:1px solid #e7eaf1;border-radius:20px;color:#64728a;font-size:10px;padding:4px 7px}
    .toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.search{min-width:250px;border:1px solid #dce3ef;border-radius:9px;padding:10px 12px;background:#fff;outline:none}.search:focus{border-color:#7665ed;box-shadow:0 0 0 3px #7665ed22}.axis-buttons{display:flex;gap:5px;flex-wrap:wrap}.axis-buttons button{background:white;border:1px solid #dfe5ef;color:#64728c;padding:8px 10px;border-radius:8px;font-size:11px}.axis-buttons button.active{background:#eae8ff;color:#5043b5;border-color:#c9c2ff;font-weight:800}.bindings{overflow:hidden}.binding{border-top:1px solid #ebeff5}.binding:first-child{border-top:0}.binding summary{list-style:none;display:grid;grid-template-columns:minmax(180px,1.15fr) minmax(135px,.8fr) minmax(220px,1.5fr) 18px;gap:14px;align-items:start;padding:15px 18px;cursor:pointer}.binding summary::-webkit-details-marker{display:none}.binding summary:hover{background:#fafbff}.binding[open] summary{background:#f9faff}.binding .id{font-size:12px;font-weight:750;color:#253553;overflow-wrap:anywhere}.binding small{display:block;color:#8490a5;margin-top:3px;font-size:10px}.binding .axis-tag{display:inline-block;background:#f3f2ff;color:#6554bf;padding:4px 7px;border-radius:5px;font-size:10px;font-weight:700;margin:0 4px 4px 0}.chev{color:#8a98af}.binding[open] .chev{transform:rotate(90deg)}.binding-body{padding:0 18px 18px 18px;background:#f9faff;display:grid;grid-template-columns:minmax(160px,.6fr) minmax(0,1.4fr);gap:20px}.binding-body h4{font-size:10px;letter-spacing:.8px;text-transform:uppercase;color:#7b88a1;margin:11px 0 7px}.binding-body p{margin:0;color:#465670;font-size:12px;line-height:1.5}.var-item{padding:10px 0;border-bottom:1px solid #e7eaf1}.var-item:last-child{border-bottom:0}.var-item .mono{font-size:10px}.var-label{color:#536884;font-size:11px;font-weight:750;margin-bottom:5px}.empty{padding:28px;text-align:center;color:#72819a}.notice{padding:14px 17px;margin-top:14px;background:#fff8e9;border:1px solid #f0ddaa;border-radius:10px;color:#805e22;font-size:12px;line-height:1.5}.footer{font-size:11px;color:#9aa6b8;margin-top:25px}
    @media(max-width:1050px){.detail-grid{grid-template-columns:1fr}.collections{grid-template-columns:1fr 1fr}.stats{grid-template-columns:1fr 1fr}}@media(max-width:720px){.shell{display:block}.rail{position:relative;height:auto;padding:12px}.brand{padding:0 8px 11px}.brand-mark{display:none}.rail-label,.rail-foot{display:none}.stage-select,.product-select,.screen-nav{display:flex;overflow-x:auto}.screen-nav button{width:auto;white-space:nowrap}.rail .stage-select{margin-top:9px}main{padding:24px 14px 60px}.top{display:block}.proof{display:inline-block;margin-top:15px}.stats{margin:20px 0}.collections{grid-template-columns:1fr}.binding summary{grid-template-columns:1fr 1fr 16px}.binding summary .binding-preview{grid-column:1/3;grid-row:2}.binding-body{grid-template-columns:1fr}.search{min-width:100%;width:100%}}
  </style>
</head>
<body>
  <script id="catalog-data" type="application/json">__CATALOG_DATA__</script>
  <div class="shell"><aside class="rail">
    <div class="brand"><div class="brand-mark">C/</div><strong>Cadastro de chaves</strong><span>Chassi · consulta local</span></div>
    <div class="rail-label">Etapa</div><div id="stages" class="stage-select"></div>
    <div class="rail-label">Produto</div><div id="products" class="product-select"></div>
    <div class="rail-label">Telas</div><div id="screens" class="screen-nav"></div>
    <div class="rail-foot">As chaves pertencem ao ambiente indicado neste cadastro. Em outro ambiente, registre as publicações locais.<br><br><a href="contratos.html">Ler os contratos →</a></div>
  </aside><main>
    <div class="top"><div><div class="eyebrow">Registro de publicação · leitura</div><h1 id="title">Cadastro de chaves</h1><p class="intro">Encontre o componente de layout do Core, a tela publicada por produto e cada variável de conteúdo que alimenta essa tela.</p></div><div class="proof">CADASTRO LOCAL</div></div>
    <div id="registry-note" class="notice"></div>
    <div class="stats" id="stats"></div>
    <div class="section-head"><div><h2>Mapa da etapa</h2><p>Selecione uma tela para ver o vínculo e as chaves de conteúdo.</p></div><span class="minor" id="map-subtitle"></span></div>
    <div class="panel map-wrap"><table class="map"><thead id="map-head"></thead><tbody id="map-body"></tbody></table></div>
    <div class="section-head"><div><h2 id="detail-title">Tela</h2><p>Identidades publicadas e pacote que gerou a composição.</p></div><span class="minor" id="detail-state"></span></div>
    <div id="detail" class="detail-grid"></div>
    <div class="section-head"><div><h2>Coleções do produto</h2><p>Os modos pertencem ao produto; as chaves abaixo são das coleções publicadas no Figma.</p></div></div>
    <div id="collections" class="collections"></div>
    <div class="section-head"><div><h2>Chaves de conteúdo</h2><p>Um ID lógico do pacote pode gerar variáveis em mais de uma coleção. Abra um item para ver chaves, destinos e valores por modo.</p></div><div class="minor" id="binding-count"></div></div>
    <div class="toolbar"><input id="search" class="search" type="search" placeholder="Buscar ID, destino ou chave…" aria-label="Buscar chaves de conteúdo"><div id="axis-buttons" class="axis-buttons"></div></div>
    <div id="bindings" class="panel bindings" style="margin-top:12px"></div>
    <div id="issues"></div><div class="footer">Fonte: pacotes locais + cadastro das chaves observadas no Figma. A conferência técnica das chaves não aprova conteúdo de negócio.</div>
  </main></div>
  <script>
  (() => {
    const data = JSON.parse(document.getElementById('catalog-data').textContent);
    const esc = x => String(x ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const short = x => x ? esc(x.slice(0,8) + '…' + x.slice(-7)) : '<span class="missing">não cadastrada</span>';
    const stageIds = data.stages.map(s => s.id);
    let stage = data.stages[0], productId = Object.keys(stage.products)[0], screenId = stage.screenOrder[0], axis = 'all';
    const parts = decodeURIComponent(location.hash.slice(1)).split('/');
    if (parts.length >= 3 && stageIds.includes(parts[0])) { stage = data.stages.find(s => s.id === parts[0]); if (stage.screenOrder.includes(parts[1])) screenId = parts[1]; if (stage.products[parts[2]]) productId = parts[2]; }
    const $ = id => document.getElementById(id);
    const key = value => value ? `<span class="key-actions"><code class="mono">${esc(value)}</code><button class="copy" data-copy="${esc(value)}" title="Copiar chave">Copiar</button></span>` : '<span class="missing">Não cadastrada</span>';
    const keyShort = value => value ? `<span class="key-actions"><code class="mono key-inline" title="${esc(value)}">${short(value)}</code><button class="copy" data-copy="${esc(value)}" title="Copiar chave">Copiar</button></span>` : '<span class="missing">Não cadastrada</span>';
    const target = t => [t.kind, t.within, t.name, t.property].filter(Boolean).join(' / ');
    const figmaLink = fileKey => fileKey ? `https://www.figma.com/design/${encodeURIComponent(fileKey)}` : null;
    function renderNav() {
      $('stages').innerHTML = data.stages.map(s => `<button data-stage="${esc(s.id)}" class="${s.id===stage.id?'active':''}">${esc(s.name)}</button>`).join('');
      $('products').innerHTML = Object.keys(stage.products).map(id => `<button data-product="${esc(id)}" class="${id===productId?'active':''}">${esc(id)}</button>`).join('');
      $('screens').innerHTML = stage.screenOrder.filter(id=>stage.products[productId].screens[id]).map((id,i) => `<button data-screen="${esc(id)}" class="${id===screenId?'active':''}"><span class="number">${String(i+1).padStart(2,'0')}</span>${esc(stage.screenNames[id])}</button>`).join('');
    }
    function renderMap() {
      const productIds = Object.keys(stage.products);
      $('map-head').innerHTML = `<tr><th>Tela</th><th>Layout · Core</th>${productIds.map(p => `<th>Componente · ${esc(p)}</th>`).join('')}</tr>`;
      $('map-body').innerHTML = stage.screenOrder.map(id => {
        const first = stage.products[productIds.find(p => stage.products[p].screens[id])].screens[id];
        return `<tr data-map-screen="${esc(id)}" class="${id===screenId?'selected':''}"><td><div class="screen-name">${esc(stage.screenNames[id])}</div><div class="small">${esc(id)}</div></td><td>${keyShort(first?.coreKey)}</td>${productIds.map(p => `<td>${keyShort(stage.products[p].screens[id]?.componentKey)}</td>`).join('')}</tr>`;
      }).join('');
      $('map-subtitle').textContent = `${stage.screenOrder.length} telas · ${productIds.length} produtos`;
    }
    function renderDetail() {
      const product = stage.products[productId], screen = product.screens[screenId];
      $('title').textContent = `Chaves de ${stage.name}`;
      $('detail-title').textContent = `${screen.name} · ${productId}`;
      $('detail-state').innerHTML = screen.publicationStatus === 'Conferido' ? '<span class="ok">● Chaves conferidas</span>' : '<span class="warn">● Revisar cadastro</span>';
      const productURL = figmaLink(product.fileKey), coreURL = figmaLink(screen.coreFileKey);
      const contractURL = screen.sourceContract ? '../' + screen.sourceContract : null;
      const pairs = (rows) => rows.map(([label,value])=>`<div class="pair"><label>${label}</label><div class="value">${value}</div></div>`).join('');
      $('detail').innerHTML = `<section class="panel card"><div class="card-kicker">Estrutura compartilhada</div><h3>Chassi da tela · Core</h3>${pairs([
        ['Chave de layout',key(screen.coreKey)],['Versão da etapa',esc(stage.version)],['Versão da tela',esc(screen.version)],['Origem',coreURL?`<a href="${coreURL}" target="_blank" rel="noopener noreferrer">Abrir biblioteca Core no Figma ↗</a>`:'Componente publicado no Core']
      ])}<div class="chain"><span>IDS externo</span><strong>→</strong><span>Core</span><strong>→</strong><span>${esc(productId)}</span></div></section>
      <section class="panel card"><div class="card-kicker">Composição do produto</div><h3>${esc(product.libraryName || productId)}</h3>${pairs([
        ['Chave da tela',key(screen.componentKey)],['Chave da biblioteca',keyShort(product.libraryKey)],['Versão do produto',esc(product.version)],['Estado do pacote',esc(({'technical-proof':'Prova técnica','proposal':'Proposta','approved':'Aprovado'})[product.packageState]||product.packageState)],['Pacote',`<code class="mono">${short(product.packageHash)}</code> · esquema ${esc(product.packageVersion)}`],['Observado em',product.observedAt ? esc(new Date(product.observedAt).toLocaleString('pt-BR')) : 'Não observada'],['Origem',productURL?`<a href="${productURL}" target="_blank" rel="noopener noreferrer">Abrir biblioteca no Figma ↗</a>`:'Não cadastrada'],['Contrato',contractURL?`<a href="${esc(contractURL)}" target="_blank" rel="noopener noreferrer">Abrir fonte local ↗</a>`:'Não cadastrado']
      ])}</section>`;
      const count = screen.bindings.reduce((n,b)=>n+b.variables.length,0);
      $('stats').innerHTML = [[stage.screenOrder.length,'chaves de layout'],[Object.values(stage.products).reduce((n,p)=>n+Object.keys(p.screens).length,0),'telas de produto'],[Object.values(stage.products).reduce((n,p)=>n+p.observedVariableCount,0),'variáveis com chave'],[count,`variáveis nesta tela · ${productId}`]].map(([n,l])=>`<div class="stat"><strong>${esc(n)}</strong><span>${esc(l)}</span></div>`).join('');
      $('collections').innerHTML = ['operation','context','additional'].map(a=>{const spec=product.axes[a], observed=product.collections[a];return `<article class="panel collection"><div class="card-kicker">${esc(a)}</div><h3>${esc(spec.collection)}</h3><div class="collection-key">${keyShort(observed?.key)}</div><div class="modes">${spec.modes.map(m=>`<span class="mode">${esc(m)}</span>`).join('')}</div></article>`}).join('');
      $('issues').innerHTML = screen.issues.length ? `<div class="notice"><strong>Revisão necessária:</strong> ${screen.issues.map(esc).join(' · ')}</div>` : '';
    }
    function renderBindings() {
      const screen=stage.products[productId].screens[screenId];
      const query=$('search').value.trim().toLocaleLowerCase('pt-BR');
      $('axis-buttons').innerHTML = [['all','Todos'],['operation','Operação'],['context','Contexto'],['additional','Adicionais']].map(([id,label])=>`<button data-axis="${id}" class="${id===axis?'active':''}">${label}</button>`).join('');
      const records=screen.bindings.filter(b=>{
        if(axis!=='all'&&!b.variables.some(v=>v.axis===axis))return false;
        if(!query)return true;
        return [b.id,b.type,target(b.target),...b.variables.flatMap(v=>[v.name,v.key])].join(' ').toLocaleLowerCase('pt-BR').includes(query);
      });
      $('binding-count').textContent=`${records.length} de ${screen.bindings.length} IDs lógicos`;
      $('bindings').innerHTML = records.length ? records.map(b=>{
        const vars=b.variables.filter(v=>axis==='all'||v.axis===axis);
        return `<details class="binding"><summary><div><div class="id">${esc(b.id)}</div><small>ID lógico · ${esc(b.type)}</small></div><div><small>Destino no chassi</small><span class="mono">${esc(target(b.target))}</span></div><div class="binding-preview">${vars.map(v=>`<span class="axis-tag">${esc(v.axis)}</span>`).join('')}<small>${vars.length} ${vars.length===1?'variável publicada':'variáveis publicadas'}</small></div><span class="chev">›</span></summary><div class="binding-body"><div><h4>Valor base do pacote</h4><p>${esc(String(b.default))}</p><h4>Destino</h4><p>${esc(target(b.target))}</p></div><div><h4>Variáveis no Figma</h4>${vars.map(v=>`<div class="var-item"><div class="var-label">${esc(v.axis)} · ${esc(v.name)}</div>${key(v.key)}<small>Chave da coleção: ${esc(v.collectionKey || 'não cadastrada')}</small>${Object.keys(v.overrides).length?`<small>Modos com valor próprio: ${Object.entries(v.overrides).map(([m,val])=>`${esc(m)}: ${esc(String(val))}`).join(' · ')}</small>`:'<small>Sem valor próprio além do padrão ou alias anterior.</small>'}</div>`).join('')}</div></div></details>`;
      }).join('') : '<div class="empty">Nenhuma chave corresponde ao filtro.</div>';
    }
    function render() {if(!stage.products[productId])productId=Object.keys(stage.products)[0];if(!stage.products[productId].screens[screenId])screenId=Object.keys(stage.products[productId].screens)[0];location.hash=`${stage.id}/${screenId}/${productId}`;renderNav();renderMap();renderDetail();renderBindings();}
    document.addEventListener('click',e=>{
      const copy=e.target.closest('[data-copy]');if(copy){e.stopPropagation();const value=copy.dataset.copy;const fallback=()=>{const input=document.createElement('textarea');input.value=value;document.body.appendChild(input);input.select();document.execCommand('copy');input.remove()};navigator.clipboard?.writeText(value).catch(fallback)||fallback();copy.textContent='Copiado';setTimeout(()=>copy.textContent='Copiar',1400);return;}
      const st=e.target.closest('[data-stage]');if(st){stage=data.stages.find(s=>s.id===st.dataset.stage);screenId=stage.screenOrder[0];productId=Object.keys(stage.products)[0];axis='all';$('search').value='';render();return;}
      const pr=e.target.closest('[data-product]');if(pr){productId=pr.dataset.product;axis='all';$('search').value='';render();return;}
      const sc=e.target.closest('[data-screen],[data-map-screen]');if(sc){screenId=sc.dataset.screen||sc.dataset.mapScreen;if(!stage.products[productId].screens[screenId])productId=Object.keys(stage.products).find(p=>stage.products[p].screens[screenId]);axis='all';$('search').value='';render();return;}
      const ax=e.target.closest('[data-axis]');if(ax){axis=ax.dataset.axis;renderBindings();}
    });
    $('registry-note').textContent=data.registryNote||'Cadastro de chaves do ambiente local.';
    $('search').addEventListener('input',renderBindings);render();
  })();
  </script>
</body>
</html>
